# Copy this file to .env and fill in your key(s).
# All keys are OPTIONAL — the script runs fully free without any key.
#
# Without any keys:   OpenStreetMap discovery + Puppeteer scoring + CSS heuristic design scoring
# With GOOGLE_API_KEY: Google Places discovery + PageSpeed Insights scoring
# With ANTHROPIC_API_KEY: Claude Vision replaces heuristic design scoring (more accurate)

# Google API key — enables Google Places (better business coverage)
# and PageSpeed Insights (faster, more accurate scoring).
# Enable: Places API, PageSpeed Insights API
# https://console.cloud.google.com/
# GOOGLE_API_KEY=your_key_here

# Separate PSI key (optional — defaults to GOOGLE_API_KEY if set)
# PSI_API_KEY=your_key_here

# Anthropic API key — enables Claude Vision for visual design scoring
# Uses claude-haiku-4-5 (~$0.001 per site). Without this, CSS heuristics are used instead.
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_key_here
